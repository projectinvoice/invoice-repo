# ═══════════════════════════════════════════════════════════════
# Copiez ce fichier en .env et renseignez vos vraies valeurs.
# Le fichier .env ne doit JAMAIS être versionné (déjà exclu par .gitignore).
# ═══════════════════════════════════════════════════════════════

# --- Site ---
# URL publique de base de votre site (sans slash final). Doit être accessible
# depuis Internet en production (MoneyFusion doit pouvoir appeler webhook_url).
SITE_BASE_URL=http://127.0.0.1:8000

# --- MoneyFusion (paiement des abonnements) ---
# URL d'API unique obtenue en créant une "application" sur votre tableau de
# bord MoneyFusion (moneyfusion.net). Laissez vide pour désactiver le paiement.
MONEYFUSION_API_URL=

# URL de vérification du statut d'un paiement ({token} est remplacé automatiquement).
# ⚠️ À confirmer auprès de docs.moneyfusion.net ou du support avant la mise en
# production — voir README_ABONNEMENT.md pour le détail.
MONEYFUSION_STATUS_CHECK_TEMPLATE=https://www.pay.moneyfusion.net/paiementNotif/{token}

# --- Email (récupération de mot de passe) ---
# Backend par défaut : les emails s'affichent dans la console (rien n'est
# réellement envoyé). Pour un envoi réel, décommentez et complétez ci-dessous.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@votre-domaine.com

# Durée de validité d'un lien de réinitialisation de mot de passe, en secondes.
# 86400 = 24 heures.
PASSWORD_RESET_TIMEOUT=86400
